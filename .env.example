# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Sender addresses for outgoing mail. Defaults are
# "Mad Vervet Hostel <info@madvervet.com>" (inquiries) and
# "Mad Vervet Hostel <booking@madvervet.com>" (bookings) — both require
# madvervet.com to be a verified domain in Resend. Until then, use Resend's
# test sender for both:
# EMAIL_FROM_INQUIRY="Mad Vervet Hostel <onboarding@resend.dev>"
# EMAIL_FROM_BOOKING="Mad Vervet Hostel <onboarding@resend.dev>"
# (test mode only delivers to your Resend account's email address)
# EMAIL_FROM, if set, overrides both of the above.
EMAIL_FROM_INQUIRY="Mad Vervet Hostel <info@madvervet.com>"
EMAIL_FROM_BOOKING="Mad Vervet Hostel <booking@madvervet.com>"

# Where booking/inquiry notifications are sent. Optional override — if unset,
# booking notifications route per location (addis@madvervet.com /
# nairobi@madvervet.com) and inquiries go to info@madvervet.com.
# HOSTEL_NOTIFICATION_EMAIL=info@madvervet.com

# AI FAQ chatbot (netlify/functions/ai-chat.js — server-side only)
ANTHROPIC_API_KEY=

# PMS base URL (availability + bookings API). Optional — defaults to
# https://pms.madvervet.com. Used server-side by the stripe-webhook function
# to enter prepaid bookings; the browser uses the same URL hardcoded in
# js/booking.js (static JS can't read env vars) — keep the two in sync.
# PMS_BASE_URL=https://pms.madvervet.com

# WhatsApp number used for the chat widget's team-chat fallback.
# NOTE: also hardcoded in js/chat-widget.js (static JS can't read env vars) —
# keep the two in sync.
WHATSAPP_BUSINESS_NUMBER=251923577808
