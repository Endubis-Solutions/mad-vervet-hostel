# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Sender address for outgoing mail. Defaults to
# "Mad Vervet Hostel <bookings@madvervet.com>" which requires madvervet.com to
# be a verified domain in Resend. Until then, use Resend's test sender:
# EMAIL_FROM="Mad Vervet Hostel <onboarding@resend.dev>"
# (test mode only delivers to your Resend account's email address)
EMAIL_FROM=madvervet@gmail.com

# Where booking/inquiry notifications are sent
HOSTEL_NOTIFICATION_EMAIL=info@madvervet.com

# AI FAQ chatbot (netlify/functions/ai-chat.js — server-side only)
ANTHROPIC_API_KEY=

# WhatsApp number used for the chat widget's team-chat fallback.
# NOTE: also hardcoded in js/chat-widget.js (static JS can't read env vars) —
# keep the two in sync.
WHATSAPP_BUSINESS_NUMBER=251923577808
